{
  "name": "freeride-dolomites",
  "version": "1.0.0",
  "private": true,
  "description": "Neve, meteo in quota, valanghe e webcam per il freeride in Dolomiti e Friuli",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "dati": "node scripts/aggiorna-dati.mjs",
    "dati:demo": "node scripts/aggiorna-dati.mjs --demo",
    "calibra": "node scripts/calibra.mjs",
    "webcam": "node scripts/controlla-webcam.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=mobile --project=piccolo --project=iphone",
    "test:desktop": "playwright test --project=desktop",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:setup": "playwright install chromium webkit"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "wrangler": "^4.0.0",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
