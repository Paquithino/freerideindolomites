{
  "name": "freeride-dolomites",
  "version": "1.0.0",
  "private": true,
  "description": "Neve, meteo in quota, valanghe e webcam per il freeride in Dolomiti e Friuli",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
